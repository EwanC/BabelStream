+
+register_flag_optional(CMAKE_CXX_COMPILER
+        "Any CXX compiler that is supported by CMake detection"
+        "c++")
+
+register_flag_optional(SLANGC_EXECUTABLE
+        "Path to the Slang compiler executable"
+        "slangc")
+
+macro(setup)
+    set(CMAKE_CXX_STANDARD 17)
+    find_package(Vulkan REQUIRED)
+    register_link_library(Vulkan::Vulkan)
+endmacro()
+
+macro(setup_target NAME)
+    if (IS_ABSOLUTE "${SLANGC_EXECUTABLE}")
+        set(_slangc "${SLANGC_EXECUTABLE}")
+    else ()
+        find_program(_slangc NAMES "${SLANGC_EXECUTABLE}" REQUIRED)
+    endif ()
+
+    set(_shader_src "${CMAKE_CURRENT_SOURCE_DIR}/src/vulkan/stream.slang")
+    set(_shader_dir "${CMAKE_CURRENT_BINARY_DIR}/vulkan-shaders")
+    file(MAKE_DIRECTORY "${_shader_dir}/float")
+    file(MAKE_DIRECTORY "${_shader_dir}/double")
+
+    set(_entries init copy mul add triad nstream dot)
+    set(_outputs)
+
+    foreach (_precision IN ITEMS float double)
+        if (_precision STREQUAL "double")
+            set(_use_double 1)
+        else ()
+            set(_use_double 0)
+        endif ()
+
+        foreach (_entry IN LISTS _entries)
+            set(_out "${_shader_dir}/${_precision}/${_entry}.spv")
+            add_custom_command(
+                OUTPUT "${_out}"
+                COMMAND "${_slangc}"
+                        "${_shader_src}"
+                        -target spirv
+                        -profile spirv_1_5
+                        -stage compute
+                        -entry "${_entry}"
+                        -DUSE_DOUBLE=${_use_double}
+                        -o "${_out}"
+                DEPENDS "${_shader_src}"
+                VERBATIM
+            )
+            list(APPEND _outputs "${_out}")
+        endforeach ()
+    endforeach ()
+
+    add_custom_target(${NAME}_slang_shaders DEPENDS ${_outputs})
+    add_dependencies(${NAME} ${NAME}_slang_shaders)
+    target_compile_definitions(${NAME} PRIVATE VULKAN_SHADER_DIR="${_shader_dir}")
+endmacro()

