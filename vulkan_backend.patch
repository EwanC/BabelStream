+template <class T>
+void VulkanStream<T>::init_arrays(T initA, T initB, T initC) {
+  initA_ = initA;
+  initB_ = initB;
+  initC_ = initC;
+
+  forEachChunk([&](size_t offset, size_t count) {
+    updateChunkDescriptors(offset * sizeof(T), count * sizeof(T));
+    dispatch(*pipelines.init, ceilDiv(count, workgroup_size), static_cast<uint32_t>(count));
+  });
+}
+
+template <class T>
+void VulkanStream<T>::copyDeviceToHost(const Buffer& src, std::vector<T>& dst) {
+  dst.resize(array_size);
+
+  forEachChunk([&](size_t offset, size_t count) {
+    vk::CommandBufferAllocateInfo allocInfo;
+    allocInfo.commandPool = *commandPool;
+    allocInfo.level = vk::CommandBufferLevel::ePrimary;
+    allocInfo.commandBufferCount = 1;
+    auto commands = device->allocateCommandBuffersUnique(allocInfo);
+    auto& cmd = commands.front();
+
+    vk::CommandBufferBeginInfo beginInfo;
+    beginInfo.flags = vk::CommandBufferUsageFlagBits::eOneTimeSubmit;
+    cmd->begin(beginInfo);
+
+    vk::MemoryBarrier computeToTransfer(
+        vk::AccessFlagBits::eShaderWrite,
+        vk::AccessFlagBits::eTransferRead);
+    cmd->pipelineBarrier(
+        vk::PipelineStageFlagBits::eComputeShader,
+        vk::PipelineStageFlagBits::eTransfer,
+        {}, {computeToTransfer}, {}, {});
+
+    vk::BufferCopy region(offset * sizeof(T), 0, count * sizeof(T));
+    cmd->copyBuffer(*src.buffer, *staging.buffer, region);
+
+    vk::MemoryBarrier transferToHost(
+        vk::AccessFlagBits::eTransferWrite,
+        vk::AccessFlagBits::eHostRead);
+    cmd->pipelineBarrier(
+        vk::PipelineStageFlagBits::eTransfer,
+        vk::PipelineStageFlagBits::eHost,
+        {}, {transferToHost}, {}, {});
+
+    cmd->end();
+
+    const vk::CommandBuffer raw = *cmd;
+    vk::SubmitInfo submitInfo;
+    submitInfo.commandBufferCount = 1;
+    submitInfo.pCommandBuffers = &raw;
+
+    queue.submit(submitInfo, nullptr);
+    queue.waitIdle();
+
+    std::memcpy(dst.data() + offset, staging.mapped, count * sizeof(T));
+  });
+}
+
+template <class T>
+void VulkanStream<T>::get_arrays(T const*& a, T const*& b, T const*& c) {
+  copyDeviceToHost(d_a, h_a);
+  copyDeviceToHost(d_b, h_b);
+  copyDeviceToHost(d_c, h_c);
+
+  a = h_a.data();
+  b = h_b.data();
+  c = h_c.data();
+}
+
+void listDevices(void) {
+  auto instance = makeInstance();
+  const auto devices = enumerateDevices(*instance);
+
+  if (devices.empty()) {
+    std::cerr << "No devices found." << std::endl;
+    return;
+  }
+
+  std::cout << "\nDevices:" << std::endl;
+  for (size_t i = 0; i < devices.size(); ++i) {
+    std::cout << i << ": " << devices[i].getProperties().deviceName << std::endl;
+  }
+  std::cout << std::endl;
+}
+
+std::string getDeviceName(const int device) {
+  auto instance = makeInstance();
+  const auto devices = enumerateDevices(*instance);
+
+  if (device < 0 || static_cast<size_t>(device) >= devices.size()) {
+    throw std::runtime_error("Error asking for name for non-existent device");
+  }
+
+  return devices[device].getProperties().deviceName;
+}
+
+std::string getDeviceDriver(const int device) {
+  auto instance = makeInstance();
+  const auto devices = enumerateDevices(*instance);
+
+  if (device < 0 || static_cast<size_t>(device) >= devices.size()) {
+    throw std::runtime_error("Error asking for driver for non-existent device");
+  }
+
+  return queryDriverString(devices[device]);
+}
