+template <class T>
+class VulkanStream : public Stream<T>
+{
+  struct Buffer {
+    vk::UniqueBuffer buffer;
+    vk::UniqueDeviceMemory memory;
+    vk::DeviceSize size{0};
+    void* mapped{nullptr};
+  };
+
+  struct Pipelines {
+    vk::UniquePipeline init;
+    vk::UniquePipeline copy;
+    vk::UniquePipeline mul;
+    vk::UniquePipeline add;
+    vk::UniquePipeline triad;
+    vk::UniquePipeline nstream;
+    vk::UniquePipeline dot;
+  };
+
+  struct alignas(16) ShaderParams {
+    uint32_t elementCount;
+    uint32_t gridSize;
+    T initA;
+    T initB;
+    T initC;
+    T scalar;
+  };
+
+  intptr_t array_size;
+  T initA_;
+  T initB_;
+  T initC_;
+  T scalar_;
+
+  vk::UniqueInstance instance;
+  vk::PhysicalDevice physicalDevice;
+  vk::UniqueDevice device;
+  vk::Queue queue;
+  uint32_t queueFamilyIndex{0};
+
+  vk::UniqueCommandPool commandPool;
+  vk::UniqueDescriptorSetLayout descriptorSetLayout;
+  vk::UniquePipelineLayout pipelineLayout;
+  vk::UniqueDescriptorPool descriptorPool;
+  vk::DescriptorSet descriptorSet{};
+
+  Pipelines pipelines;
+
+  Buffer d_a;
+  Buffer d_b;
+  Buffer d_c;
+  Buffer d_partial;
+  Buffer staging;
+  Buffer partialStaging;
+
+  size_t chunk_elements{0};
+  uint32_t workgroup_size{128};
+  uint32_t dot_groups{1};
+
+  std::vector<T> h_a;
+  std::vector<T> h_b;
+  std::vector<T> h_c;
+
+public:
+  VulkanStream(BenchId bs, intptr_t array_size, int device_id, T initA, T initB, T initC);
+  ~VulkanStream() override;
+
+  void copy() override;
+  void add() override;
+  void mul() override;
+  void triad() override;
+  void nstream() override;
+  T dot() override;
+
+  void init_arrays(T initA, T initB, T initC) override;
+  void get_arrays(T const*& a, T const*& b, T const*& c) override;
+
+private:
+  uint32_t findMemoryType(uint32_t typeBits, vk::MemoryPropertyFlags properties) const;
+  Buffer createBuffer(vk::DeviceSize size, vk::BufferUsageFlags usage,
+                      vk::MemoryPropertyFlags properties, bool map = false) const;
+
+  Pipelines createPipelines();
+  vk::UniquePipeline createPipeline(const std::string& entry) const;
+  std::vector<char> readShader(const std::string& entry) const;
+
+  void updateChunkDescriptors(vk::DeviceSize offset, vk::DeviceSize range);
+  void dispatch(const vk::Pipeline& pipeline, uint32_t groupsX, uint32_t elementCount);
+  void copyDeviceToHost(const Buffer& src, std::vector<T>& dst);
+
+  template <class Fn>
+  void forEachChunk(Fn&& fn);
+};
+
+void listDevices(void);
+std::string getDeviceName(const int device);
+std::string getDeviceDriver(const int device);

