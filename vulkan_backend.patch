+#if USE_DOUBLE
+typedef double StreamType;
+#else
+typedef float StreamType;
+#endif
+
+static const uint WORKGROUP_SIZE = 128;
+
+struct PushConstants
+{
+    uint elementCount;
+    uint gridSize;
+    StreamType initA;
+    StreamType initB;
+    StreamType initC;
+    StreamType scalar;
+};
+
+[[vk::push_constant]]
+ConstantBuffer<PushConstants> gParams;
+
+[[vk::binding(0, 0)]] RWStructuredBuffer<StreamType> gA;
+[[vk::binding(1, 0)]] RWStructuredBuffer<StreamType> gB;
+[[vk::binding(2, 0)]] RWStructuredBuffer<StreamType> gC;
+[[vk::binding(3, 0)]] RWStructuredBuffer<StreamType> gPartial;
+
+groupshared StreamType scratch[WORKGROUP_SIZE];
+
+[numthreads(WORKGROUP_SIZE, 1, 1)]
+void init(uint3 tid : SV_DispatchThreadID)
+{
+    if (tid.x >= gParams.elementCount) return;
+    gA[tid.x] = gParams.initA;
+    gB[tid.x] = gParams.initB;
+    gC[tid.x] = gParams.initC;
+}
+
+[numthreads(WORKGROUP_SIZE, 1, 1)]
+void copy(uint3 tid : SV_DispatchThreadID)
+{
+    if (tid.x >= gParams.elementCount) return;
+    gC[tid.x] = gA[tid.x];
+}
+
+[numthreads(WORKGROUP_SIZE, 1, 1)]
+void mul(uint3 tid : SV_DispatchThreadID)
+{
+    if (tid.x >= gParams.elementCount) return;
+    gB[tid.x] = gParams.scalar * gC[tid.x];
+}
+
+[numthreads(WORKGROUP_SIZE, 1, 1)]
+void add(uint3 tid : SV_DispatchThreadID)
+{
+    if (tid.x >= gParams.elementCount) return;
+    gC[tid.x] = gA[tid.x] + gB[tid.x];
+}
+
+[numthreads(WORKGROUP_SIZE, 1, 1)]
+void triad(uint3 tid : SV_DispatchThreadID)
+{
+    if (tid.x >= gParams.elementCount) return;
+    gA[tid.x] = gB[tid.x] + gParams.scalar * gC[tid.x];
+}
+
+[numthreads(WORKGROUP_SIZE, 1, 1)]
+void nstream(uint3 tid : SV_DispatchThreadID)
+{
+    if (tid.x >= gParams.elementCount) return;
+    gA[tid.x] += gB[tid.x] + gParams.scalar * gC[tid.x];
+}
+
+[numthreads(WORKGROUP_SIZE, 1, 1)]
+void dot(
+    uint3 dispatchThreadID : SV_DispatchThreadID,
+    uint3 groupThreadID : SV_GroupThreadID,
+    uint3 groupID : SV_GroupID)
+{
+    StreamType local = 0;
+
+    for (uint i = dispatchThreadID.x; i < gParams.elementCount; i += gParams.gridSize)
+    {
+        local += gA[i] * gB[i];
+    }
+
+    scratch[groupThreadID.x] = local;
+    GroupMemoryBarrierWithGroupSync();
+
+    for (uint offset = WORKGROUP_SIZE >> 1; offset > 0; offset >>= 1)
+    {
+        if (groupThreadID.x < offset)
+        {
+            scratch[groupThreadID.x] += scratch[groupThreadID.x + offset];
+        }
+        GroupMemoryBarrierWithGroupSync();
+    }
+
+    if (groupThreadID.x == 0)
+    {
+        gPartial[groupID.x] = scratch[0];
+    }
+}
